# Variables del proyecto. Copia este archivo como .env.local (no se sube a
# GitHub) y rellena los valores. En Vercel se configuran en Settings → Environment
# Variables. Nunca pongas tokens reales en este archivo.

# Opcionales: por defecto proyecto yxpe2eq3, dataset production.
# NEXT_PUBLIC_SANITY_PROJECT_ID=yxpe2eq3
# NEXT_PUBLIC_SANITY_DATASET=production

# Token "Viewer" de sanity.io/manage → API → Tokens. Vista previa de borradores.
SANITY_API_READ_TOKEN=

# Token "Editor". Solo para scripts (carga de contenido de la Fase 4); el sitio no lo usa.
SANITY_API_WRITE_TOKEN=

# Secreto compartido con el webhook de Sanity → /api/revalidate (Fase 9).
SANITY_REVALIDATE_SECRET=
